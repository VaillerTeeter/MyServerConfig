{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "desync",
    "keepalive",
    "tarampampam",
    "Vailler"
  ],
  "flagWords": [
    "hte",
    "teh",
    "recieve",
    "occured",
    "doesnt",
    "cant",
    "dont",
    "couldnt",
    "shouldnt",
    "wont",
    "wouldnt",
    "isnt",
    "wasnt",
    "werent",
    "arent",
    "havent",
    "hasnt",
    "hadnt",
    "neednt"
  ],
  "dictionaries": [
    "en_US",
    "markdown",
    "networking-terms"
  ],
  "ignorePaths": [
    ".git/**",
    "conf.d/cert/**",
    "conf.d/error/**",
    "logs/**"
  ],
  "enableGlobDot": true,
  "useGitignore": true,
  "maxNumberOfProblems": 50,
  "minWordLength": 4
}
